<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FoodSaveCM.Pages.RegisterPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctrl="clr-namespace:FoodSaveCM.Controls"
             Shell.NavBarIsVisible="False" Title="Inscription"
             Style="{StaticResource PageStyle}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="26,26,26,10" Spacing="0">
                <Label Text="Inscription" Style="{StaticResource BigTitle}" FontSize="36" />

                <ctrl:Field x:Name="NameField" Caption="Nom complet" CaptionSize="17" CaptionMargin="32,0,0,0"
                            Placeholder="Entrez votre nom" InputFontSize="17" FieldHeight="42" CenterText="True" Margin="0,16,0,0" />
                <ctrl:Field x:Name="EmailField" Caption="Email" CaptionSize="17" CaptionMargin="32,0,0,0"
                            Placeholder="exemple@email.com" InputFontSize="17" KeyboardType="Email" FieldHeight="42" Margin="0,18,0,0" />
                <ctrl:Field x:Name="PassField" Caption="Mot de passe" CaptionSize="17" CaptionMargin="32,0,0,0"
                            Placeholder="entrez votre mot de passe" InputFontSize="12" IsPassword="True" FieldHeight="42" CenterText="False" Margin="0,18,0,0" />
                <ctrl:Field x:Name="ConfirmField" Caption="Confirmer mot de passe" CaptionSize="17" CaptionMargin="28,0,0,0"
                            Placeholder="confirmez" InputFontSize="12" IsPassword="True" FieldHeight="42" CenterText="False" Margin="0,18,0,0" />

                <Label x:Name="ErrorLabel" TextColor="#D32F2F" FontSize="13" IsVisible="False" HorizontalTextAlignment="Center" Margin="0,10,0,0" />

                <Button Text="S'inscrire" Style="{StaticResource PrimaryButton}" FontSize="18" HeightRequest="46" CornerRadius="8"
                        Margin="28,40,28,0" Clicked="OnRegister" />

                <Label Text="Déjà un compte ?" Style="{StaticResource Body}" FontSize="17" HorizontalOptions="Center" Margin="0,22,0,0" />
                <Label Text="Se connecter" TextColor="{StaticResource Leaf}" FontSize="17" FontAttributes="Bold"
                       TextDecorations="Underline" HorizontalOptions="Center" Margin="0,8,0,0">
                    <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnLogin" /></Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" ColumnSpacing="10" Padding="16,6,16,18">
            <BoxView HeightRequest="1.5" Color="#444444" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="🍀" FontSize="30" />
            <BoxView Grid.Column="2" HeightRequest="1.5" Color="#444444" VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
