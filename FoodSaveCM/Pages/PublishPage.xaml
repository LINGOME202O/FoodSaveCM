<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FoodSaveCM.Pages.PublishPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctrl="clr-namespace:FoodSaveCM.Controls"
             Title="Publier" Style="{StaticResource PageStyle}">
    <ScrollView>
        <VerticalStackLayout Padding="30,6,30,28" Spacing="0">
            <Label Text="Publier un invendu" Style="{StaticResource BigTitle}" FontSize="28" />
            <Label Text="Remplissez les détails pour publier votre invendu" Style="{StaticResource Body}" FontSize="12"
                   HorizontalOptions="Center" Margin="0,12,0,0" />

            <ctrl:Field x:Name="NameField" Caption="Nom du panier" CaptionSize="17" Placeholder="Ex : Panier de légumes frais"
                        FieldHeight="44" Margin="0,16,0,0" />
            <ctrl:Field x:Name="DescField" Caption="Description" CaptionSize="17" Placeholder="Ex : Tomates,courgettes....."
                        FieldHeight="44" Margin="0,18,0,0" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="14" Margin="0,18,0,0">
                <ctrl:Field x:Name="QtyField" Caption="Quantité" CaptionSize="17" Placeholder="Ex : 3 Paniers" InputFontSize="13"
                            KeyboardType="Numeric" FieldHeight="36" />
                <ctrl:Field x:Name="OldPriceField" Grid.Column="1" Caption="Prix d'origine" CaptionSize="17" Placeholder="Ex : 3000 FCFA"
                            InputFontSize="13" KeyboardType="Numeric" FieldHeight="36" />
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="14" Margin="0,18,0,0">
                <ctrl:Field x:Name="PriceField" Caption="Prix réduit" CaptionSize="17" Placeholder="Ex : 1800 FCFA" InputFontSize="13"
                            KeyboardType="Numeric" FieldHeight="36" />
                <ctrl:Field x:Name="SlotField" Grid.Column="1" Caption="Créneau de retrait" CaptionSize="17" Placeholder="Aujourd'hui 17h-19h"
                            InputFontSize="13" FieldHeight="36" />
            </Grid>

            <Border BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2C2C2E}" StrokeThickness="0" HeightRequest="190"
                    StrokeShape="RoundRectangle 12" Margin="0,22,0,0">
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPhoto" /></Border.GestureRecognizers>
                <Grid>
                    <VerticalStackLayout x:Name="PhotoHint" VerticalOptions="Center" Spacing="6">
                        <Label Text="📷" FontSize="52" HorizontalOptions="Center" />
                        <Label Text="Ajouter une photo du panier" Style="{StaticResource Body}" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" Margin="0,8,0,0" />
                        <Label Text="PNG, JPG jusqu'à 5 Mo" Style="{StaticResource Muted}" FontSize="12" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <Image x:Name="Preview" Aspect="AspectFill" IsVisible="False" />
                </Grid>
            </Border>

            <Label x:Name="ErrorLabel" TextColor="#D32F2F" FontSize="13" IsVisible="False" HorizontalTextAlignment="Center" Margin="0,10,0,0" />
            <Button Text="Publier maintenant" Style="{StaticResource PrimaryButton}" FontSize="18" CornerRadius="8" HeightRequest="46"
                    Margin="18,22,18,0" Clicked="OnPublish" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
