<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FoodSaveCM.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctrl="clr-namespace:FoodSaveCM.Controls"
             Shell.NavBarIsVisible="False" Title="Accueil"
             Style="{StaticResource PageStyle}">
    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Padding="20,24,12,0" Spacing="0">
            <Label x:Name="Hello" Style="{StaticResource BigTitle}" FontSize="28" />
            <Label Text="Que recherches-tu pour aujourd'hui ?" Style="{StaticResource Muted}" FontSize="14"
                   HorizontalOptions="Center" Margin="0,16,0,0" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,22,8,0">
                <Border Style="{StaticResource FieldBorder}" HeightRequest="40" BackgroundColor="{AppThemeBinding Light=#EDEDED, Dark=#2C2C2E}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Text="🔍" FontSize="14" VerticalOptions="Center" Margin="12,0,0,0" />
                        <Entry x:Name="SearchEntry" Grid.Column="1" Placeholder="rechercher des produits,des boissons"
                               PlaceholderColor="#9A9AA0" BackgroundColor="Transparent" FontSize="13" TextChanged="OnSearch"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" BackgroundColor="{StaticResource Brand}" StrokeThickness="0" WidthRequest="42" HeightRequest="40"
                        StrokeShape="RoundRectangle 10">
                    <Image Source="ic_sliders.png" WidthRequest="26" HeightRequest="26" />
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFilter" /></Border.GestureRecognizers>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,Auto" Margin="0,32,8,0">
                <Label Text="Categories" Style="{StaticResource Body}" FontSize="19" FontAttributes="Bold" Margin="2,0,0,0" />
                <Label Grid.Column="1" Text="Voir tout &gt;" TextColor="{StaticResource Leaf}" FontSize="18" VerticalOptions="Center">
                    <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnAllCategories" /></Label.GestureRecognizers>
                </Label>
            </Grid>
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,16,0,0">
                <HorizontalStackLayout x:Name="Chips" Spacing="8" />
            </ScrollView>

            <Grid ColumnDefinitions="*,Auto" Margin="0,28,28,0">
                <Label Text="Produits populaires" Style="{StaticResource Body}" FontSize="19" FontAttributes="Bold" Margin="2,0,0,0" />
                <Label Grid.Column="1" Text="Voir tout" TextColor="{StaticResource Leaf}" FontSize="18" VerticalOptions="Center">
                    <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnSeeAll" /></Label.GestureRecognizers>
                </Label>
            </Grid>
        </VerticalStackLayout>

        <CollectionView x:Name="List" Grid.Row="1" Margin="20,10,12,0" ItemSizingStrategy="MeasureFirstItem">
            <CollectionView.ItemTemplate>
                <DataTemplate><ctrl:ProductCard /></DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="Aucun produit trouvé" Style="{StaticResource Muted}" HorizontalOptions="Center" Margin="0,40" />
            </CollectionView.EmptyView>
        </CollectionView>

        <ctrl:NavBar Grid.Row="2" Current="Accueil" />
    </Grid>
</ContentPage>
