<?xml version="1.0" encoding="UTF-8" ?>
<ContentView x:Class="FoodSaveCM.Controls.ProductCard"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Border Style="{StaticResource Card}" Padding="0" Margin="0,6">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnOpen" />
        </Border.GestureRecognizers>
        <Grid ColumnDefinitions="110,*,Auto">
            <Image Source="{Binding Image}" Aspect="AspectFill" HeightRequest="104" />

            <VerticalStackLayout Grid.Column="1" Padding="12,8" Spacing="2" VerticalOptions="Center">
                <Label Text="{Binding Name}" Style="{StaticResource Body}" FontAttributes="Bold" FontSize="16" LineBreakMode="TailTruncation" />
                <Label Text="{Binding Details}" Style="{StaticResource Muted}" FontSize="12" LineBreakMode="TailTruncation" />
                <Label Text="{Binding Shop}" Style="{StaticResource Muted}" FontSize="11" LineBreakMode="TailTruncation" />
                <HorizontalStackLayout Spacing="8">
                    <Label Text="{Binding PriceText}" TextColor="{StaticResource Brand}" FontAttributes="Bold" FontSize="17" />
                    <Label Text="{Binding OldPriceText}" IsVisible="{Binding HasDiscount}" TextDecorations="Strikethrough"
                           Style="{StaticResource Muted}" FontSize="12" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="2" Padding="8,8,12,8" Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
                <Label Text="{Binding HeartIcon}" FontSize="22" HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFav" />
                    </Label.GestureRecognizers>
                </Label>
                <Button Text="+" FontSize="24" FontAttributes="Bold" Padding="0"
                        WidthRequest="44" HeightRequest="44" CornerRadius="22"
                        BackgroundColor="Black" TextColor="White" Clicked="OnAdd" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
