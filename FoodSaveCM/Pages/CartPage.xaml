<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FoodSaveCM.Pages.CartPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctrl="clr-namespace:FoodSaveCM.Controls"
             Shell.NavBarIsVisible="False" Title="Panier"
             Style="{StaticResource PageStyle}">
    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="16,12,16,0">
        <Label Text="Mon panier" Style="{StaticResource BigTitle}" FontSize="30" Margin="0,0,0,8" />

        <CollectionView x:Name="List" Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,6">
                        <Grid ColumnDefinitions="90,*,Auto">
                            <Image Source="{Binding Product.Image}" Aspect="AspectFill" HeightRequest="96" />
                            <VerticalStackLayout Grid.Column="1" Padding="10,8" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Product.Name}" Style="{StaticResource Body}" FontAttributes="Bold" />
                                <Label Text="{Binding Product.Shop}" Style="{StaticResource Muted}" FontSize="12" />
                                <Label Text="{Binding TotalText}" TextColor="{StaticResource Brand}" FontAttributes="Bold" />
                                <HorizontalStackLayout Spacing="10" Margin="0,4,0,0">
                                    <Button Text="−" Command="{Binding Decrease}" WidthRequest="34" HeightRequest="34" Padding="0" CornerRadius="17"
                                            BackgroundColor="#D9D9D9" TextColor="Black" />
                                    <Label Text="{Binding Quantity}" Style="{StaticResource Body}" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Button Text="+" Command="{Binding Increase}" WidthRequest="34" HeightRequest="34" Padding="0" CornerRadius="17"
                                            BackgroundColor="Black" TextColor="White" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="🗑" Command="{Binding Remove}" BackgroundColor="Transparent"
                                    VerticalOptions="Start" FontSize="20" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" Spacing="10" Margin="0,60">
                    <Label Text="🛒" FontSize="60" HorizontalOptions="Center" />
                    <Label Text="Votre panier est vide" Style="{StaticResource SectionTitle}" HorizontalOptions="Center" />
                    <Label Text="Ajoutez des invendus pour les sauver !" Style="{StaticResource Muted}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <VerticalStackLayout x:Name="Footer" Grid.Row="2" Spacing="10" Margin="0,8,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Total" Style="{StaticResource SectionTitle}" />
                <Label x:Name="TotalLabel" Grid.Column="1" TextColor="{StaticResource Brand}" FontSize="22" FontAttributes="Bold" />
            </Grid>
            <Button Text="Réserver tout" Style="{StaticResource PrimaryButton}" Clicked="OnReserveAll" />
        </VerticalStackLayout>
        <ctrl:NavBar Grid.Row="3" Current="Carte" />
    </Grid>
</ContentPage>
