<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FoodSaveCM.Pages.ConfirmationPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Réservation" Style="{StaticResource PageStyle}">
    <ScrollView>
        <VerticalStackLayout Padding="30,6,30,28" Spacing="0">
            <Border BackgroundColor="#D9D9D9" StrokeThickness="0" WidthRequest="90" HeightRequest="90"
                    StrokeShape="RoundRectangle 45" HorizontalOptions="Center">
                <Label Text="✔" FontSize="50" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Text="Réservation&#10;confirmée !" TextColor="#8E8E93" FontSize="30" FontAttributes="Bold"
                   HorizontalTextAlignment="Center" Margin="0,10,0,0" />

            <BoxView Color="{StaticResource Leaf}" HeightRequest="16" CornerRadius="8" Margin="0,22,0,0" />

            <Border BackgroundColor="White" StrokeThickness="0" Padding="6" HorizontalOptions="Center" Margin="0,30,0,0">
                <Image x:Name="QrImage" WidthRequest="120" HeightRequest="120" />
            </Border>
            <Label Text="{Binding Code, StringFormat='Code de retrait : {0}'}" Style="{StaticResource Muted}" FontSize="12"
                   HorizontalOptions="Center" Margin="0,6,0,0" />

            <Border Style="{StaticResource GrayCard}" Padding="24,18" Margin="0,22,0,0">
                <VerticalStackLayout Spacing="16">
                    <Label Text="{Binding Headline}" Style="{StaticResource Body}" FontAttributes="Bold" FontSize="17" />
                    <Label Text="{Binding PickupShort, StringFormat='Retrait {0}'}" Style="{StaticResource Body}" FontAttributes="Bold" FontSize="17" />
                    <Label Text="{Binding Address}" Style="{StaticResource Body}" FontAttributes="Bold" FontSize="17" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding PaymentText}" Style="{StaticResource Body}" FontSize="13" HorizontalOptions="Center" Margin="0,14,0,0" />
            <Button Text="💳 Payer maintenant (Mobile Money)" Style="{StaticResource PrimaryButton}" FontSize="15" HeightRequest="46"
                    IsVisible="{Binding CanPay}" Margin="24,8,24,0" Clicked="OnPay" />

            <Button Text="Voir l'itinéraire" BackgroundColor="{StaticResource Leaf}" TextColor="White" FontAttributes="Bold"
                    FontSize="18" CornerRadius="8" HeightRequest="46" Margin="24,28,24,0" Clicked="OnRoute" />
            <Button Text="Mes réservations" Style="{StaticResource SoftButton}" FontSize="18" CornerRadius="8" HeightRequest="46"
                    Margin="40,18,40,0" Clicked="OnMyReservations" />
            <Button x:Name="ReviewBtn" Text="⭐ Noter ce commerce" Style="{StaticResource SoftButton}" FontSize="14" HeightRequest="44"
                    IsVisible="False" Margin="40,12,40,0" Clicked="OnReview" />
            <Button x:Name="CancelBtn" Text="Annuler la réservation" BackgroundColor="Transparent" TextColor="#D32F2F"
                    FontSize="13" Margin="0,10,0,0" Clicked="OnCancel" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
