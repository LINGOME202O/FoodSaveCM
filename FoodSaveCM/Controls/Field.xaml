<?xml version="1.0" encoding="UTF-8" ?>
<ContentView x:Class="FoodSaveCM.Controls.Field"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <VerticalStackLayout Spacing="6">
        <Label x:Name="Lbl" Style="{StaticResource Body}" FontSize="15" />
        <Border Style="{StaticResource FieldBorder}">
            <Grid ColumnDefinitions="*,Auto">
                <Entry x:Name="Input" BackgroundColor="Transparent" FontSize="14" Margin="8,0,0,0"
                       TextChanged="OnTextChanged"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                <Label x:Name="Eye" Grid.Column="1" Text="👁" FontSize="18" IsVisible="False"
                       VerticalOptions="Center" Margin="0,0,14,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEyeTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </Border>
    </VerticalStackLayout>
</ContentView>
