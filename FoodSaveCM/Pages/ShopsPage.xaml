<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FoodSaveCM.Pages.ShopsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Carte des commerces" Style="{StaticResource PageStyle}">
    <CollectionView x:Name="List" Margin="16,8">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border Style="{StaticResource Card}" Margin="0,6">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label Text="{Binding Icon}" FontSize="36" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{Binding Name}" Style="{StaticResource Body}" FontAttributes="Bold" FontSize="17" />
                            <Label Text="{Binding Line}" Style="{StaticResource Muted}" FontSize="12" />
                            <Label Text="{Binding OpenText}" TextColor="{StaticResource Brand}" FontSize="12" />
                            <Label Text="{Binding OffersText}" Style="{StaticResource Body}" FontSize="12" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <Button Grid.Column="2" Text="📍 Y aller" FontSize="12" HeightRequest="40" CornerRadius="10" Padding="10,0"
                                BackgroundColor="{StaticResource Brand}" TextColor="White" VerticalOptions="Center" Clicked="OnGo" />
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
