<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FoodSaveCM.Pages.PublicationsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctrl="clr-namespace:FoodSaveCM.Controls"
             Title="Mes publications" Style="{StaticResource PageStyle}">
    <Grid RowDefinitions="*,Auto" Padding="16,8">
        <CollectionView x:Name="List">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Supprimer" BackgroundColor="#D32F2F" Invoked="OnDelete" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <ctrl:ProductCard />
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout Margin="0,60" Spacing="10">
                    <Label Text="📦" FontSize="56" HorizontalOptions="Center" />
                    <Label Text="Vous n'avez rien publié" Style="{StaticResource SectionTitle}" HorizontalOptions="Center" />
                    <Label Text="Publiez vos invendus pour éviter le gaspillage." Style="{StaticResource Muted}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
        <Button Grid.Row="1" Text="＋ Publier un invendu" Style="{StaticResource PrimaryButton}" Clicked="OnPublish" Margin="0,8,0,0" />
    </Grid>
</ContentPage>
