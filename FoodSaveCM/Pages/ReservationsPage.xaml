<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FoodSaveCM.Pages.ReservationsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctrl="clr-namespace:FoodSaveCM.Controls"
             Shell.NavBarIsVisible="False" Title="Mes réservations"
             Style="{StaticResource PageStyle}">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="22,0,22,0">
        <Label Text="Mes réservations" Style="{StaticResource BigTitle}" FontSize="30" Margin="0,18,0,18" />

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="0" RowSpacing="0">
            <Button x:Name="TabUp" Text="A venir" Clicked="OnTabUp" CornerRadius="0" HeightRequest="50" FontSize="19" Padding="0" />
            <Button x:Name="TabPast" Grid.Column="1" Text="Passées" Clicked="OnTabPast" CornerRadius="0" HeightRequest="50" FontSize="19" Padding="0" />
            <Button x:Name="TabCancel" Grid.Column="2" Text="Annulées" Clicked="OnTabCancel" CornerRadius="0" HeightRequest="50" FontSize="19" Padding="0" />
            <BoxView x:Name="UnderUp" Grid.Row="1" HeightRequest="2" />
            <BoxView x:Name="UnderPast" Grid.Row="1" Grid.Column="1" HeightRequest="2" />
            <BoxView x:Name="UnderCancel" Grid.Row="1" Grid.Column="2" HeightRequest="2" />
        </Grid>

        <CollectionView x:Name="List" Grid.Row="2" Margin="0,18,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="10,10,12,12" Margin="0,0,0,34" StrokeShape="RoundRectangle 10">
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                            <Label Text="{Binding Icon}" FontSize="42" VerticalOptions="Start" />
                            <Label Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding DisplayShop}" Style="{StaticResource Body}" FontSize="19" VerticalOptions="Center" />
                            <Label Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Summary}" Style="{StaticResource Body}" FontSize="13" />
                            <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Chip}" BackgroundColor="{Binding ChipBg}"
                                    HorizontalOptions="Start" Padding="12,5" VerticalOptions="End">
                                <Label Text="{Binding Chip}" TextColor="{Binding ChipFg}" FontSize="13" />
                            </Border>
                            <VerticalStackLayout Grid.Column="2" Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding IsUpcoming}" Spacing="0" VerticalOptions="End">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnShowQr" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Label Text="▦" FontSize="40" HorizontalOptions="Center" Style="{StaticResource Body}" />
                                <Label Text="Code QR" Style="{StaticResource Body}" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="Aucune réservation ici" Style="{StaticResource Muted}" HorizontalOptions="Center" Margin="0,50" />
            </CollectionView.EmptyView>
        </CollectionView>

        <ctrl:NavBar Grid.Row="3" Current="Accueil" Margin="-12,0" />
    </Grid>
</ContentPage>
