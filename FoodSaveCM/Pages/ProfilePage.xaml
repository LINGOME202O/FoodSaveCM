<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FoodSaveCM.Pages.ProfilePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctrl="clr-namespace:FoodSaveCM.Controls"
             Shell.NavBarIsVisible="False" Title="Profil"
             Style="{StaticResource PageStyle}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="30,8,30,20" Spacing="0">
                <Border StrokeThickness="0" HeightRequest="300" StrokeShape="RoundRectangle 26">
                    <Image Source="profil.jpeg" Aspect="AspectFill" />
                </Border>

                <Border Style="{StaticResource GrayCard}" Padding="8,24" Margin="-12,16,-12,0" StrokeShape="RoundRectangle 10">
                    <Label x:Name="NameLabel" Style="{StaticResource Body}" FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="Center" />
                </Border>
                <Border Style="{StaticResource GrayCard}" Padding="8,24" Margin="-12,24,-12,0" StrokeShape="RoundRectangle 10">
                    <Label Text="MES RESERVATIONS" Style="{StaticResource Body}" FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="Center" />
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnReservations" /></Border.GestureRecognizers>
                </Border>
                <Border Style="{StaticResource GrayCard}" Padding="8,24" Margin="-12,24,-12,0" StrokeShape="RoundRectangle 10">
                    <Label Text="MES PUBLICATIONS" Style="{StaticResource Body}" FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="Center" />
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPublications" /></Border.GestureRecognizers>
                </Border>

                <!-- Fonctionnalités ajoutées -->
                <Button Text="＋ Publier un invendu" Style="{StaticResource PrimaryButton}" FontSize="16" HeightRequest="48" CornerRadius="10"
                        Margin="0,30,0,0" Clicked="OnPublish" />

                <Button Text="🏪 Valider un retrait (commerçant)" Style="{StaticResource SoftButton}" FontSize="14" HeightRequest="46"
                        Margin="0,12,0,0" Clicked="OnValidate" />

                <Button Text="📊 Tableau de bord commerçant" Style="{StaticResource SoftButton}" FontSize="14" HeightRequest="46"
                        Margin="0,10,0,0" Clicked="OnDashboard" />

                <Label Text="Mon impact" Style="{StaticResource Body}" FontAttributes="Bold" FontSize="17" Margin="0,24,0,8" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border Style="{StaticResource Chip}" Padding="6,12">
                        <VerticalStackLayout>
                            <Label x:Name="MealsLabel" FontSize="22" FontAttributes="Bold" TextColor="#1B5E20" HorizontalOptions="Center" />
                            <Label Text="repas sauvés" FontSize="11" TextColor="#1B5E20" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Chip}" Padding="6,12">
                        <VerticalStackLayout>
                            <Label x:Name="Co2Label" FontSize="22" FontAttributes="Bold" TextColor="#1B5E20" HorizontalOptions="Center" />
                            <Label Text="kg CO₂ évités*" FontSize="11" TextColor="#1B5E20" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Chip}" Padding="6,12">
                        <VerticalStackLayout>
                            <Label x:Name="MoneyLabel" FontSize="18" FontAttributes="Bold" TextColor="#1B5E20" HorizontalOptions="Center" />
                            <Label Text="FCFA économisés" FontSize="11" TextColor="#1B5E20" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
                <Label Text="*Estimation indicative (≈ 2,5 kg CO₂e par repas sauvé)." Style="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,18,0,0">
                    <Label Text="🌙 Mode sombre" Style="{StaticResource Body}" VerticalOptions="Center" />
                    <Switch x:Name="DarkSwitch" Grid.Column="1" OnColor="{StaticResource Brand}" Toggled="OnDarkToggled" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <Label Text="🔔 Alertes « dernière chance »" Style="{StaticResource Body}" VerticalOptions="Center" />
                    <Switch x:Name="NotifSwitch" Grid.Column="1" OnColor="{StaticResource Brand}" Toggled="OnNotifToggled" />
                </Grid>
                <Button Text="Se déconnecter" BackgroundColor="Transparent" TextColor="#D32F2F" FontAttributes="Bold" Clicked="OnLogout" Margin="0,8,0,0" />
            </VerticalStackLayout>
        </ScrollView>
        <ctrl:NavBar Grid.Row="1" Current="Profil" />
    </Grid>
</ContentPage>
