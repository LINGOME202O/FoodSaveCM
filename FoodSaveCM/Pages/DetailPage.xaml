<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FoodSaveCM.Pages.DetailPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Détail" Style="{StaticResource PageStyle}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Partager" Clicked="OnShare" />
    </ContentPage.ToolbarItems>
    <ScrollView>
        <VerticalStackLayout Padding="22,8,22,28" Spacing="0">
            <Grid>
                <Border StrokeThickness="1" Stroke="#CFCFCF" HeightRequest="200" StrokeShape="RoundRectangle 12">
                    <Image Source="{Binding Image}" Aspect="AspectFill" />
                </Border>
                <Border BackgroundColor="#B3FFFFFF" StrokeThickness="0" HorizontalOptions="End" VerticalOptions="Start"
                        Margin="8" Padding="7,4" StrokeShape="RoundRectangle 16">
                    <Label Text="{Binding HeartIcon}" FontSize="16" />
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFav" /></Border.GestureRecognizers>
                </Border>
            </Grid>

            <Label Text="{Binding Name}" Style="{StaticResource BigTitle}" FontSize="30" HorizontalTextAlignment="Center" Margin="0,10,0,0" />

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="58" Margin="0,22,0,0">
                <Label Text="{Binding PriceText}" TextColor="{StaticResource Leaf}" FontSize="19" FontAttributes="Bold" VerticalOptions="Center" />
                <Border IsVisible="{Binding HasDiscount}" BackgroundColor="{StaticResource Brand}" StrokeThickness="0" Padding="22,5"
                        StrokeShape="Rectangle">
                    <Label Text="{Binding DiscountText}" TextColor="Black" FontAttributes="Bold" FontSize="17" />
                </Border>
            </HorizontalStackLayout>

            <Label x:Name="SectionTitle" Text="Contenu du panier" Style="{StaticResource Body}" FontSize="18" FontAttributes="Bold" Margin="26,44,0,0" />
            <Label Text="{Binding Description}" Style="{StaticResource Body}" FontSize="15" Margin="6,26,0,0" />

            <VerticalStackLayout x:Name="ContentsBox" BindableLayout.ItemsSource="{Binding Contents}" Spacing="0" Margin="6,34,0,0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding ., StringFormat='-{0}'}" Style="{StaticResource Body}" FontSize="15" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="Créneau de retrait" Style="{StaticResource Body}" FontSize="18" FontAttributes="Bold" Margin="20,26,0,0" />
            <HorizontalStackLayout Spacing="14" Margin="8,10,0,0">
                <Border Style="{StaticResource Chip}" Padding="14,5"><Label Text="{Binding PickupText}" TextColor="#1B1B1B" FontSize="14" /></Border>
                <Border Style="{StaticResource Chip}" Padding="22,5"><Label Text="Retrait sur place" TextColor="#1B1B1B" FontSize="14" /></Border>
            </HorizontalStackLayout>

            <Button x:Name="ReserveBtn" Text="Réserver ce panier" Style="{StaticResource PrimaryButton}" FontSize="18" CornerRadius="10"
                    HeightRequest="48" Margin="20,26,20,0" Clicked="OnReserve" />

            <Label Text="{Binding StockText}" Style="{StaticResource Body}" HorizontalOptions="Center" FontAttributes="Bold" FontSize="13" Margin="0,16,0,0" />
            <Label x:Name="RatingLabel" Style="{StaticResource Body}" FontSize="13" HorizontalOptions="Center" />
            <Label x:Name="CountdownLabel" Style="{StaticResource Body}" TextColor="#E65100" FontAttributes="Bold" FontSize="13" HorizontalOptions="Center" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="20,10,20,0">
                <Button Text="🛒 Ajouter au panier" Style="{StaticResource SoftButton}" FontSize="13" HeightRequest="44" Clicked="OnAddToCart" />
                <Button Grid.Column="1" Text="📍 Itinéraire" Style="{StaticResource SoftButton}" FontSize="13" HeightRequest="44" Clicked="OnRoute" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
