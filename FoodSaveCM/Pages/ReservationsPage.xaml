<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FoodSaveCM.Pages.ReservationsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Mes réservations" Style="{StaticResource PageStyle}">
    <Grid RowDefinitions="Auto,*" Padding="16,8">
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6" Margin="0,0,0,8">
            <Button x:Name="TabUp" Text="À venir" Clicked="OnTabUp" CornerRadius="10" HeightRequest="44" />
            <Button x:Name="TabPast" Grid.Column="1" Text="Passées" Clicked="OnTabPast" CornerRadius="10" HeightRequest="44" />
            <Button x:Name="TabCancel" Grid.Column="2" Text="Annulées" Clicked="OnTabCancel" CornerRadius="10" HeightRequest="44" />
        </Grid>

        <CollectionView x:Name="List" Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,8">
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                            <Label Text="{Binding Icon}" FontSize="40" Grid.RowSpan="2" VerticalOptions="Start" />
                            <Label Grid.Column="1" Text="{Binding Shop}" Style="{StaticResource Body}" FontAttributes="Bold" FontSize="17" />
                            <Label Grid.Column="1" Grid.Row="1" Text="{Binding Summary}" Style="{StaticResource Body}" FontSize="13" />
                            <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Chip}" BackgroundColor="{Binding ChipBg}"
                                    HorizontalOptions="Start">
                                <Label Text="{Binding Chip}" TextColor="#1B1B1B" FontSize="13" />
                            </Border>
                            <VerticalStackLayout Grid.Column="2" Grid.RowSpan="3" Spacing="6" IsVisible="{Binding IsUpcoming}">
                                <Button Text="▦ Code QR" FontSize="12" FontAttributes="Bold" HeightRequest="44" Padding="10,0"
                                        BackgroundColor="Black" TextColor="White" CornerRadius="10" Clicked="OnShowQr" />
                                <Button Text="Annuler" FontSize="12" HeightRequest="36" Padding="10,0"
                                        BackgroundColor="Transparent" TextColor="#D32F2F" Clicked="OnCancel" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="Aucune réservation ici 🍃" Style="{StaticResource Muted}" HorizontalOptions="Center" Margin="0,50" />
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>
