<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FoodSaveCM.Pages.ConfirmationPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Réservation" Style="{StaticResource PageStyle}">
    <ScrollView>
        <VerticalStackLayout Padding="24,12,24,28" Spacing="14">
            <Border BackgroundColor="{StaticResource SoftGreen}" StrokeThickness="0" WidthRequest="90" HeightRequest="90"
                    StrokeShape="RoundRectangle 45" HorizontalOptions="Center">
                <Label Text="✔" FontSize="46" TextColor="{StaticResource Brand}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Text="Réservation confirmée !" Style="{StaticResource BigTitle}" FontSize="28" TextColor="{StaticResource Brand}" />
            <ProgressBar Progress="1" ProgressColor="{StaticResource Leaf}" HeightRequest="8" />

            <Border BackgroundColor="White" StrokeThickness="0" Padding="12" HorizontalOptions="Center" StrokeShape="RoundRectangle 16">
                <Image x:Name="QrImage" WidthRequest="190" HeightRequest="190" />
            </Border>
            <Label Text="{Binding Code, StringFormat='Code de retrait : {0}'}" Style="{StaticResource Body}" FontAttributes="Bold"
                   HorizontalOptions="Center" FontSize="17" />
            <Label Text="Présentez ce QR code au commerçant lors du retrait." Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />

            <Border Style="{StaticResource Card}" Padding="18">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding Shop, StringFormat='🏪 {0}'}" Style="{StaticResource Body}" FontAttributes="Bold" FontSize="17" />
                    <Label Text="{Binding Pickup, StringFormat='🕒 Retrait : {0}'}" Style="{StaticResource Body}" FontAttributes="Bold" />
                    <Label Text="{Binding Address, StringFormat='📍 {0}'}" Style="{StaticResource Body}" FontAttributes="Bold" />
                    <Label Text="{Binding Total, StringFormat='💰 À payer sur place : {0:N0} FCFA'}" Style="{StaticResource Body}" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Voir l'itinéraire" BackgroundColor="{StaticResource Leaf}" TextColor="White" FontAttributes="Bold"
                    FontSize="17" CornerRadius="10" HeightRequest="50" Clicked="OnRoute" />
            <Button Text="Mes réservations" Style="{StaticResource SoftButton}" Clicked="OnMyReservations" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
