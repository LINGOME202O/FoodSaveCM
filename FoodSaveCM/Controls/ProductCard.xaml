<?xml version="1.0" encoding="UTF-8" ?>
<ContentView x:Class="FoodSaveCM.Controls.ProductCard"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Border Style="{StaticResource GrayCard}" Padding="0" Margin="0,8,8,8">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnOpen" />
        </Border.GestureRecognizers>
        <Grid ColumnDefinitions="100,*,Auto">
            <Image Source="{Binding Image}" Aspect="AspectFill" WidthRequest="100" HeightRequest="88" />

            <VerticalStackLayout Grid.Column="1" Padding="4,6" Spacing="3" VerticalOptions="Center" HorizontalOptions="Center">
                <Label Text="{Binding Name}" Style="{StaticResource Body}" FontSize="13" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                <Label Text="{Binding Details}" Style="{StaticResource Body}" FontSize="13" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                <Label Text="{Binding PriceText}" Style="{StaticResource Body}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Button Grid.Column="2" Text="+" FontSize="26" FontAttributes="Bold" Padding="0" BackgroundColor="Black" TextColor="White"
                    CornerRadius="20" WidthRequest="40" HeightRequest="40" Margin="6,0,10,0" VerticalOptions="Center" Clicked="OnAdd" />
        </Grid>
    </Border>
</ContentView>
